<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Base theme ===== -->
    <style name="Theme.IslamicCompanion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/noto_sans</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.IslamicCompanion.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_crescent</item>
        <item name="postSplashScreenTheme">@style/Theme.IslamicCompanion</item>
    </style>

    <!-- Ramadan seasonal overlay -->
    <style name="Theme.IslamicCompanion.Ramadan" parent="Theme.IslamicCompanion">
        <item name="colorPrimary">@color/ramadan_primary</item>
        <item name="colorSecondary">@color/ramadan_accent</item>
        <item name="android:colorBackground">@color/ramadan_background</item>
        <item name="colorSurface">@color/ramadan_surface</item>
    </style>

    <!-- Eid seasonal overlay -->
    <style name="Theme.IslamicCompanion.Eid" parent="Theme.IslamicCompanion">
        <item name="colorPrimary">@color/eid_primary</item>
        <item name="colorSecondary">@color/eid_accent</item>
        <item name="android:colorBackground">@color/eid_background</item>
    </style>

    <!-- Onboarding theme — no action bar -->
    <style name="Theme.IslamicCompanion.Onboarding" parent="Theme.IslamicCompanion">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- ===== Page transition animation ===== -->
    <style name="WindowAnimationTransition">
        <item name="android:activityOpenEnterAnimation">@anim/fade_slide_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_slide_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_slide_in_reverse</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_slide_out_reverse</item>
    </style>

    <!-- ===== Widget styles ===== -->

    <style name="Widget.IslamicCompanion.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_on_primary</item>
        <item name="android:background">@color/primary</item>
    </style>

    <!-- Card: 16dp corners, 1dp border, no shadow -->
    <style name="Widget.IslamicCompanion.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Hero card — no border, primary background -->
    <style name="Widget.IslamicCompanion.HeroCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/primary</item>
    </style>

    <!-- Pill card for prayer strips -->
    <style name="Widget.IslamicCompanion.PrayerPill" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">50dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="cardBackgroundColor">@color/prayer_pill_default</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.IslamicCompanion.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@drawable/bottom_nav_color</item>
        <item name="itemTextColor">@drawable/bottom_nav_color</item>
    </style>

    <!-- Primary button with rounded corners -->
    <style name="Widget.IslamicCompanion.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.IslamicCompanion.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/btn_corner_radius</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <!-- ===== Text Appearances ===== -->

    <style name="TextAppearance.IslamicCompanion.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.IslamicCompanion.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.IslamicCompanion.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.IslamicCompanion.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.IslamicCompanion.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.IslamicCompanion.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Arabic text style -->
    <style name="TextAppearance.IslamicCompanion.Arabic" parent="TextAppearance.IslamicCompanion.Body">
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingMultiplier">1.8</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">end</item>
        <item name="android:fontFamily">@font/noto_naskh_arabic</item>
    </style>

    <!-- Quran Arabic text -->
    <style name="TextAppearance.IslamicCompanion.QuranArabic" parent="TextAppearance.IslamicCompanion.Arabic">
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingMultiplier">2.0</item>
    </style>

    <!-- Countdown timer — monospaced tabular numerals -->
    <style name="TextAppearance.IslamicCompanion.Countdown" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

</resources>
