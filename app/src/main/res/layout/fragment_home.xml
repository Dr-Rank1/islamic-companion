<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_on_primary"
            app:titleTextAppearance="@style/TextAppearance.IslamicCompanion.Title" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- SwipeRefreshLayout for pull-to-refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- ═══ HERO CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.IslamicCompanion.HeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/default_padding"
                    android:layout_marginTop="@dimen/default_padding"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Location pill + Hijri date row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/tvHijriDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="14sp"
                                android:textColor="#B3FFFFFF"
                                android:contentDescription="@string/calendar_title" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_location_unknown"
                                android:textSize="12sp"
                                app:chipBackgroundColor="#33FFFFFF"
                                app:chipIconTint="#FFFFFF"
                                android:textColor="#FFFFFF"
                                android:contentDescription="@string/settings_city"
                                style="@style/Widget.Material3.Chip.Suggestion" />

                        </LinearLayout>

                        <!-- "NEXT PRAYER" overline -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT PRAYER"
                            android:textSize="11sp"
                            android:letterSpacing="0.12"
                            android:textColor="#80FFFFFF"
                            android:layout_marginBottom="4dp" />

                        <!-- Prayer name EN + AR side by side -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvNextPrayerName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="@dimen/hero_prayer_name_size"
                                android:textColor="@color/text_on_primary"
                                android:textStyle="bold"
                                android:text="—" />

                            <TextView
                                android:id="@+id/tvNextPrayerArabic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="22sp"
                                android:textColor="@color/accent"
                                android:fontFamily="@font/noto_naskh_arabic"
                                android:textDirection="rtl" />

                        </LinearLayout>

                        <!-- Countdown -->
                        <TextView
                            android:id="@+id/tvCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"
                            android:textSize="@dimen/hero_countdown_size"
                            android:textColor="@color/text_on_primary"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:contentDescription="@string/home_next_prayer" />

                        <!-- Prayer time label -->
                        <TextView
                            android:id="@+id/tvNextPrayerTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#B3FFFFFF"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ PRAYER PILLS STRIP ═══ -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="@dimen/default_padding"
                    android:layout_marginBottom="8dp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include layout="@layout/item_prayer_pill"
                            android:id="@+id/pillFajr" />
                        <include layout="@layout/item_prayer_pill"
                            android:id="@+id/pillSunrise"
                            android:layout_marginStart="8dp" />
                        <include layout="@layout/item_prayer_pill"
                            android:id="@+id/pillDhuhr"
                            android:layout_marginStart="8dp" />
                        <include layout="@layout/item_prayer_pill"
                            android:id="@+id/pillAsr"
                            android:layout_marginStart="8dp" />
                        <include layout="@layout/item_prayer_pill"
                            android:id="@+id/pillMaghrib"
                            android:layout_marginStart="8dp" />
                        <include layout="@layout/item_prayer_pill"
                            android:id="@+id/pillIsha"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ═══ QUICK ACTIONS 2×2 GRID ═══ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/default_padding"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardQuickQuran"
                            style="@style/Widget.IslamicCompanion.Card"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/home_quick_quran">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                                android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                    android:src="@drawable/ic_quran" app:tint="@color/primary"
                                    android:contentDescription="@null"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/home_quick_quran" android:textSize="14sp"
                                    android:textColor="@color/text_primary" android:textStyle="bold"
                                    android:layout_marginTop="4dp"/>
                                <TextView android:id="@+id/tvQuranProgress"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textSize="11sp" android:textColor="@color/text_secondary"
                                    android:maxLines="1" android:ellipsize="end"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardQuickQibla"
                            style="@style/Widget.IslamicCompanion.Card"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/home_quick_qibla">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                                android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                    android:src="@drawable/ic_qibla" app:tint="@color/primary"
                                    android:contentDescription="@null"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/home_quick_qibla" android:textSize="14sp"
                                    android:textColor="@color/text_primary" android:textStyle="bold"
                                    android:layout_marginTop="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/qibla_title" android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardQuickTasbih"
                            style="@style/Widget.IslamicCompanion.Card"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/home_quick_tasbih">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                                android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                    android:src="@drawable/ic_more" app:tint="@color/primary"
                                    android:contentDescription="@null"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/home_quick_tasbih" android:textSize="14sp"
                                    android:textColor="@color/text_primary" android:textStyle="bold"
                                    android:layout_marginTop="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/tasbih_title" android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardQuickDua"
                            style="@style/Widget.IslamicCompanion.Card"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/home_quick_dua">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                                android:orientation="vertical" android:gravity="center" android:padding="12dp">
                                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                    android:src="@drawable/ic_home" app:tint="@color/primary"
                                    android:contentDescription="@null"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/home_quick_dua" android:textSize="14sp"
                                    android:textColor="@color/text_primary" android:textStyle="bold"
                                    android:layout_marginTop="4dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/dua_morning" android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>

                <!-- ═══ HADITH OF THE DAY CARD ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHadith"
                    style="@style/Widget.IslamicCompanion.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/default_padding"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/hadith_title">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvHadithPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingMultiplier="1.5"
                            android:maxLines="3"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_hadith_read_more"
                            android:textSize="13sp"
                            android:textColor="@color/primary"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ STREAK CARD (shown when streak > 0) ═══ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStreak"
                    style="@style/Widget.IslamicCompanion.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/default_padding"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/streak_title">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStreakFlame"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStreakCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStreakBest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_more"
                            app:tint="@color/text_hint"
                            android:contentDescription="@null" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══ PRAYER LOG PROMPT ═══ (contextual — shown after a prayer time passes) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPrayerPrompt"
                    style="@style/Widget.IslamicCompanion.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/default_padding"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:strokeColor="@color/primary_tint_medium"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvPrayerPromptText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrayedOnTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="@string/prayer_log_on_time"
                                android:textSize="12sp"
                                style="@style/Widget.IslamicCompanion.Button" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrayedLate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:text="@string/prayer_log_late"
                                android:textSize="12sp"
                                style="@style/Widget.IslamicCompanion.Button.Outlined" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrayedMissed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="@string/prayer_log_missed"
                                android:textSize="12sp"
                                style="@style/Widget.IslamicCompanion.Button.Outlined" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
