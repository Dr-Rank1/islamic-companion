<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/stats_title"
        android:background="@color/primary"
        app:titleTextColor="@color/text_on_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/default_padding">

            <!-- Streak card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.IslamicCompanion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvCurrentStreak"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tvBestStreak"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔥" android:textSize="32sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- On-time stats -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.IslamicCompanion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvOnTimePct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="22sp" android:textStyle="bold" android:textColor="@color/stat_on_time"/>
                    <TextView android:id="@+id/tvTotalPrayers"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tvHardestPrayer"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="@color/stat_missed"
                        android:layout_marginTop="4dp" android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weekly bar chart -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.IslamicCompanion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_weekly" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/primary"
                        android:layout_marginBottom="12dp"/>
                    <com.islamiccompanion.app.ui.stats.PrayerBarChartView
                        android:id="@+id/barChartView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stats_chart_height"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_privacy_note" android:textSize="11sp"
                        android:textColor="@color/text_hint" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reset button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_reset"
                android:textColor="@color/error"
                style="@style/Widget.IslamicCompanion.Button.Outlined"
                app:strokeColor="@color/error" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
