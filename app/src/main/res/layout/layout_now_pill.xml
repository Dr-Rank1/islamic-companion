<?xml version="1.0" encoding="utf-8"?>
<!--
    Persistent "Now" pill — shown on all screens except Home (hero card already has countdown).
    Tapping navigates to Home tab.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowPillCard"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:contentDescription="Next prayer countdown"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/primary">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvPillPrayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="12sp"
            android:textColor="#E0FFFFFF"
            android:textStyle="bold"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/tvPillPrayerArabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:fontFamily="@font/noto_naskh_arabic"
            android:textDirection="rtl"
            android:layout_marginEnd="8dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:background="#40FFFFFF"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvPillCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="12sp"
            android:textColor="@color/text_on_primary"
            android:fontFamily="monospace"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
