<?xml version="1.0" encoding="utf-8"?>
<!--
    Root layout: DrawerLayout wrapping the main content + a NavigationView drawer.

    Stack from bottom to top:
      BottomNavigationView  → always visible, full width
      AdView (persistent)  → above nav, full width
      NowPill              → floating card, centered, above ad
      NavHostFragment      → fills all remaining space above pill
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main content ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Fragment content — takes all weight-1 space -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

        <!-- Now Pill — hidden on Home (hero card already shows countdown) -->
        <FrameLayout
            android:id="@+id/nowPillWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <include
                layout="@layout/layout_now_pill"
                android:id="@+id/nowPillContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

        </FrameLayout>

        <!-- Persistent banner ad — above the bottom nav -->
        <!-- Ad placeholder — uses test IDs -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewMain"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_banner_height"
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

        <!-- Bottom navigation bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <!-- ===== Side navigation drawer ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="@color/text_primary"
        app:itemIconTint="@color/primary" />

</androidx.drawerlayout.widget.DrawerLayout>
